# Records docs/demo.gif. Run from the repo root: vhs docs/demo.tape
Output docs/demo.gif
Require pakket
Set Shell zsh
Set FontSize 15
Set Width 1100
Set Height 620
Set Padding 18
Set Theme "Catppuccin Mocha"
Set TypingSpeed 60ms

Hide
Type "export XDG_CONFIG_HOME=$(mktemp -d) PS1='$ ' && rm -rf /tmp/pakket-demo && mkdir -p /tmp/pakket-demo/Holiday/2026 && cd /tmp/pakket-demo"
Enter
Type "for i in 1 2 3 4; do head -c 300000 /dev/urandom > Holiday/2026/IMG_000$i.jpg; done; seq 1 4000 > Holiday/notes.txt; seq 1 9000 > report.csv; clear"
Enter
Show

Type "pakket"
Sleep 300ms
Enter
Sleep 1s
Space
Sleep 300ms
Space
Sleep 600ms
Type "c"
Sleep 1s
Down
Sleep 200ms
Right
Sleep 200ms
Right
Sleep 400ms
Down
Type "hunter2"
Down
Type "hunter2"
Sleep 700ms
Tab
Tab
Tab
Tab
Tab
Tab
Tab
Tab
Tab
Tab
Tab
Tab
Sleep 600ms
Enter
Sleep 1.5s
Escape
Sleep 800ms
Type "g"
Sleep 200ms
Type "j"
Sleep 300ms
Type "v"
Sleep 1s
Type "hunter2"
Enter
Sleep 2s
Escape
Sleep 500ms
Type "x"
Sleep 800ms
Tab
Tab
Type "hunter2"
Sleep 300ms
Tab
Tab
Tab
Tab
Tab
Tab
Tab
Sleep 500ms
Enter
Sleep 1.5s
Escape
Sleep 1.5s
Type "q"
Sleep 300ms
Type "pakket formats | head -12"
Enter
Sleep 4s
